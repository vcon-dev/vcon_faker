# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# The real secrets.toml is git-ignored — never commit credentials.

AWS_ACCESS_KEY = "your-aws-access-key"
AWS_SECRET_KEY = "your-aws-secret-key"
S3_BUCKET      = "your-default-bucket-name"

OPENAI_API_KEY  = "sk-..."
OPENAI_MODEL    = "gpt-4o"   # chat model used to generate conversation text
OPENAI_TTS_MODEL = "tts-1"   # text-to-speech model used for voice audio
